{
  "name": "cognipace",
  "private": true,
  "version": "1.4.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "store:check": "node scripts/validate-store-build.mjs",
    "prepare:wxt": "wxt prepare",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "typecheck": "npm run prepare:wxt && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run db:check && npm run typecheck && npm run lint && npm run test",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-table": "^8.21.3",
    "@webext-core/messaging": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11",
    "wxt": "^0.21.3"
  }
}
